# Simple Dockerfile for testing MEDUSA installation
# Use a locally available base image to avoid Docker Hub auth timeouts.
FROM ccr.ccs.tencentyun.com/buildingai/node:22.20.0

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG ALL_PROXY
ARG http_proxy
ARG https_proxy
ARG all_proxy

ENV HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    ALL_PROXY=${ALL_PROXY} \
    http_proxy=${http_proxy} \
    https_proxy=${https_proxy} \
    all_proxy=${all_proxy} \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    PIP_TRUSTED_HOST=mirrors.aliyun.com \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

# Install Python from a domestic Debian mirror with retry knobs.
RUN set -eux; \
    sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources; \
    sed -i 's|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources; \
    apt-get -o Acquire::Retries=6 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        python3 \
        python3-pip \
        python3-venv; \
    rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy source and install MEDUSA from local checkout.
COPY . /app
RUN python3 -m venv /opt/medusa && \
    /opt/medusa/bin/pip install --no-cache-dir --upgrade pip setuptools wheel && \
    /opt/medusa/bin/pip install --no-cache-dir /app

# Set MEDUSA as entrypoint
ENTRYPOINT ["/opt/medusa/bin/medusa"]
CMD ["--help"]
